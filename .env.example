# ==============================================================================
# RakshakGIS Environment Configuration (.env.example)
#
# Copy this file to .env for local development:
#   cp .env.example .env     (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# DO NOT commit .env with real secrets to version control.
# In demo mode (DATA_MODE=demo), no external API keys are required.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Runtime Mode
# ------------------------------------------------------------------------------
# APP_ENV: development | staging | production
APP_ENV=development

# DATA_MODE: demo | live | simulation
# - demo: Uses local synthetic / mocked datasets; no external APIs required
# - live: Connects to live weather, GIS, and satellite telemetry providers
# - simulation: Reruns backend computation engines with parameter overrides
DATA_MODE=demo

# ------------------------------------------------------------------------------
# Infrastructure & Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=rakshakgis
POSTGRES_USER=rakshak
POSTGRES_PASSWORD=rakshak_dev_secret

# DATABASE_URL for SQLAlchemy / GeoAlchemy2:
# In Docker Compose, the database host is 'db'. For host-direct connections, use 'localhost'.
DATABASE_URL=postgresql://rakshak:rakshak_dev_secret@db:5432/rakshakgis

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 256-bit random key for production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# ------------------------------------------------------------------------------
# External Geospatial & Weather Services (Optional in DEMO mode)
# ------------------------------------------------------------------------------
# India Meteorological Department (IMD) API
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in

# GeoServer Integration
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# OpenStreetMap / OSRM Routing Engine
OSM_ROUTING_URL=http://router.project-osrm.org

# Basemap Style URL for MapLibre GL
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ------------------------------------------------------------------------------
# LLM & AI Services (Optional; explainability only - not for numerical risk)
# ------------------------------------------------------------------------------
# Note: RakshakGIS numerical risk engines never use LLMs; LLM is used strictly for text summaries
LLM_API_KEY=
