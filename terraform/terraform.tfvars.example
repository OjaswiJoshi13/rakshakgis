# ==============================================================================
# RakshakGIS Infrastructure Configuration Example
# Copy this file to 'terraform.tfvars' and customize for your deployment.
# NEVER commit 'terraform.tfvars' to version control!
# ==============================================================================

# AWS Region (ap-south-1 = Mumbai)
aws_region = "ap-south-1"

# Environment identifier
environment = "prod"

# Project prefix
project_name = "rakshakgis"

# EC2 Instance Sizing
# Recommended: "t3.small" (2 vCPU, 2 GiB RAM) or "t3.medium" (2 vCPU, 4 GiB RAM)
# Warning: "t2.micro" (1 GiB RAM) may encounter OOM under heavy PostGIS load.
instance_type = "t3.small"

# EC2 Key Pair Name (Must exist in target AWS region if SSH key access is needed)
# Leave empty if using AWS Systems Manager Session Manager
key_name = "rakshakgis-deploy-key"

# Restrict SSH Access (Port 22)
# Replace with your corporate/home IP: e.g. ["203.0.113.50/32"]
admin_ssh_cidr = ["0.0.0.0/0"]

# EBS Storage Volume Size in GiB
root_volume_size = 30
root_volume_type = "gp3"

# Allocate Static Elastic IP
allocate_elastic_ip = true
