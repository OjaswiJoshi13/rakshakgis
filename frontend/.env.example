# ==============================================================================
# RakshakGIS Frontend Environment Variables (.env.example)
#
# Copy this file to .env.local for local frontend development:
#   cp .env.example .env.local
# ==============================================================================

# Backend API Base URL (FastAPI backend server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Operational Data Mode: demo | live | simulation
NEXT_PUBLIC_DATA_MODE=demo

# Active Region Profile Identifier (matches backend RegionProfileId)
NEXT_PUBLIC_ACTIVE_REGION=himalayan_pilot

# MapLibre GL Basemap Style URL
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Application Version
NEXT_PUBLIC_APP_VERSION=0.1.0
